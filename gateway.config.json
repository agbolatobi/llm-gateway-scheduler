{
  "version": 1,
  "gateway": {"listen": "127.0.0.1:8000", "max_active_requests": 1},
  "quotas": {
    "request_window_seconds": 60,
    "token_window_seconds": 3600,
    "user": {"requests": 20, "tokens": 40000},
    "global_ceiling": {"requests": 60, "tokens": 200000}
  },
  "models": [
    {
      "id": "local-llm",
      "max_active_requests": 1,
      "aliases": ["default"],
      "context_limit": 4096,
      "default_output_tokens": 128,
      "max_output_tokens": 1024,
      "limits": {"requests": 30, "tokens": 100000},
      "backend": {
        "runtime_id": "local-llm-runtime",
        "engine": "llama.cpp",
        "base_url": "http://127.0.0.1:8080",
        "expected_model": "local-llm"
      },
      "launch": {
        "executable": "runtime/llama-b11669/llama-server",
        "model_file": "models/qwen2.5-1.5b-instruct-q4_k_m.gguf",
        "device": "none",
        "parallel": 1,
        "threads": 4
      }
    }
  ]
}
