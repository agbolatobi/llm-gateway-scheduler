# Plain KEY=value, not a shell script. No credentials belong here.
TARGET=gke
PROJECT_ID=YOUR_PROJECT_ID
REGION=us-central1
ZONE=us-central1-a
CLUSTER_NAME=llm-lab
IMAGE_REPOSITORY=us-central1-docker.pkg.dev/YOUR_PROJECT_ID/llm-lab
# Filled from the digest output of deploy/scripts/images.py.
GATEWAY_IMAGE=REPLACE_GATEWAY_IMAGE_WITH_SHA256_DIGEST
RUNTIME_IMAGE=REPLACE_RUNTIME_IMAGE_WITH_SHA256_DIGEST
MODEL_URI=gs://YOUR_MODEL_BUCKET/model.gguf
MODEL_SHA256=REPLACE_WITH_SHA256_OF_YOUR_GGUF
MODEL_SERVICE_ACCOUNT=llm-lab-models@YOUR_PROJECT_ID.iam.gserviceaccount.com
MODEL_ID=local-llm
CONTEXT_TOKENS=4096
DEFAULT_OUTPUT_TOKENS=1024
MAX_OUTPUT_TOKENS=2048
RUNTIME_THREADS=2
RUNTIME_CPU_REQUEST=2
RUNTIME_CPU_LIMIT=3
RUNTIME_MEMORY_REQUEST=4Gi
RUNTIME_MEMORY_LIMIT=6Gi
MODEL_STORAGE=10Gi
KEY_STORAGE=1Gi
# Blank uses the cluster's default StorageClass (must support fsGroup).
STORAGE_CLASS=
GPU=false
CHAT_URL=http://127.0.0.1:8000/chat/
