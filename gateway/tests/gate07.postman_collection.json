                  "mode": "raw",
                  "raw": "{\n  \"model\": \"local-llm\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"hello\"\n    }\n  ],\n  \"max_tokens\": 128,\n  \"stream\": false\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "header": [
                  {
                    "key": "X-Test-User",
                    "value": "actual"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
