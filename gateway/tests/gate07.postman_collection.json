{
  "info": {
    "name": "Gateway tests — reusable",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Reusable gateway and queue tests. Run all tests replays GATE-07 plus deterministic Go queue tests; manual folders remain available. Same collection/environment variables. Test-only scheduler controls support policy reload without changing URL/key."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{gateway_test_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_test_url",
      "value": "http://127.0.0.1:8005",
      "type": "string"
    },
    {
      "key": "gateway_test_key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Where are my test files?",
      "request": {
        "method": "GET",
        "url": "{{gateway_test_url}}/tests/status"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Test server is reachable\", () => pm.response.to.have.status(200));",
              "pm.test(\"Current file locations are available\", () => { const files=pm.response.json().files; pm.expect(files.postman_collection).to.be.a(\"string\"); pm.expect(files.test_cases).to.be.a(\"string\"); pm.expect(files.latest_report).to.be.a(\"string\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Run all tests — safe to repeat",
      "request": {
        "method": "POST",
        "url": "{{gateway_test_url}}/tests/run",
        "description": "Resets private test state automatically, then tests the real Go gateway against controlled fake backends. No model weights or normal gateway are touched. Wait for the JSON report (usually several seconds)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const report = pm.response.json();",
              "pm.test(\"Entire suite passed\", () => { pm.response.to.have.status(200); pm.expect(report.status).to.equal(\"passed\"); pm.expect(report.checks).to.be.an(\"array\").that.is.not.empty; });",
              "for (const check of report.checks || []) { pm.test(check.name, () => pm.expect(check.passed).to.equal(true)); }",
              "pm.test(\"Report saved locally\", () => pm.expect(report.files.latest_report).to.be.a(\"string\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Reset test state — optional",
      "request": {
        "method": "POST",
        "url": "{{gateway_test_url}}/tests/reset",
        "description": "Clears the private gateway's quotas and test state while retaining the same public URL, API key and collection. Run all tests already does this automatically."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Reset succeeded\", () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.equal(\"reset\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Manual requests — send individually",
      "description": "Reset before each scenario. State persists between requests. All routes use the same URL/key. Controls are test-only.",
      "item": [
        {
          "name": "GATE-07: disable waiting for busy-rejection checks",
          "request": {
            "method": "POST",
            "url": "{{gateway_test_url}}/tests/scheduler",
            "description": "Legacy capacity tests expect immediate 503. Queue examples have their own enable requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"policy\": \"fifo\",\n  \"max_waiting_requests\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "Reset before a manual scenario",
          "request": {
            "method": "POST",
            "url": "{{gateway_test_url}}/tests/reset",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List registered models",
          "request": {
            "method": "GET",
            "url": "{{gateway_test_url}}/v1/models",
            "description": ""
          },
          "event": [
