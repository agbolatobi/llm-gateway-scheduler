{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "gateway"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "selector": {
      "matchLabels": {
        "app": "llm-gateway"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "llm-gateway"
        }
      },
      "spec": {
        "serviceAccountName": "gateway",
        "terminationGracePeriodSeconds": 160,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "runAsGroup": 10001,
          "fsGroup": 10001,
          "fsGroupChangePolicy": "OnRootMismatch",
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "initContainers": [
          {
            "name": "initialize-keys",
            "image": "gateway-image",
            "command": [
              "/container-util",
              "init-keys",
              "/data/keys"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "100m",
                "memory": "32Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "keys",
                "mountPath": "/data",
                "readOnly": false
              }
            ]
          },
          {
            "name": "verify-model",
            "image": "runtime-image",
            "command": [
              "/bin/sh",
              "-ec",
              "printf \"%s  /models/model.gguf\\n\" \"$MODEL_SHA256\" | sha256sum -c -"
            ],
            "env": [
              {
                "name": "MODEL_SHA256",
                "value": "REPLACE_MODEL_SHA256"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "32Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "64Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "models",
                "mountPath": "/models",
                "readOnly": true
              }
            ]
          },
          {
            "name": "runtime",
            "image": "runtime-image",
            "restartPolicy": "Always",
            "args": [
              "--model",
              "/models/model.gguf",
              "--alias",
              "local-llm",
              "--host",
              "127.0.0.1",
              "--port",
              "8080",
              "--ctx-size",
              "4096",
              "--parallel",
              "1",
              "--threads",
              "2",
              "--slots",
              "--slot-save-path",
              "/tmp",
              "--no-webui",
              "--n-gpu-layers",
              "0"
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "limits": {
                "cpu": "3",
                "memory": "6Gi"
              }
            },
            "volumeMounts": [
              {
                "name": "models",
                "mountPath": "/models",
                "readOnly": true
              },
              {
                "name": "runtime-tmp",
                "mountPath": "/tmp",
                "readOnly": false
              }
            ],
            "startupProbe": {
              "exec": {
                "command": [
                  "curl",
                  "-fsS",
                  "--max-time",
                  "2",
                  "http://127.0.0.1:8080/health"
                ]
              },
              "periodSeconds": 2,
              "failureThreshold": 300
            },
            "readinessProbe": {
              "exec": {
                "command": [
                  "curl",
                  "-fsS",
                  "--max-time",
                  "2",
                  "http://127.0.0.1:8080/health"
                ]
              },
              "periodSeconds": 5
            },
            "livenessProbe": {
              "exec": {
                "command": [
                  "/bin/sh",
                  "-c",
                  "kill -0 1"
                ]
              },
              "periodSeconds": 10
            }
          }
        ],
        "containers": [
          {
            "name": "gateway",
            "image": "gateway-image",
            "args": [
              "--config",
              "/config/gateway.config.json",
              "--config-dir",
              "/data/keys",
              "--listen",
              "0.0.0.0:8000",
              "--allow-remote-listen",
              "--shutdown-timeout",
              "130s"
            ],
            "ports": [
              {
                "name": "http",
                "containerPort": 8000
              }
            ],
            "env": [
              {
                "name": "HOME",
                "value": "/tmp"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "256Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "config",
                "mountPath": "/config",
                "readOnly": true
              },
              {
                "name": "keys",
                "mountPath": "/data",
                "readOnly": false
              },
              {
                "name": "gateway-tmp",
                "mountPath": "/tmp",
                "readOnly": false
              }
            ],
            "startupProbe": {
              "httpGet": {
                "path": "/health",
                "port": "http"
              },
              "periodSeconds": 2,
              "failureThreshold": 30
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/health",
                "port": "http"
              },
              "periodSeconds": 5
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/health",
                "port": "http"
              },
              "periodSeconds": 10
            }
          }
        ],
        "volumes": [
          {
            "name": "config",
            "configMap": {
              "name": "gateway-config"
            }
          },
          {
            "name": "keys",
            "persistentVolumeClaim": {
              "claimName": "gateway-keys"
            }
          },
          {
            "name": "models",
            "persistentVolumeClaim": {
              "claimName": "gateway-models"
            }
          },
          {
            "name": "gateway-tmp",
            "emptyDir": {
              "sizeLimit": "64Mi"
            }
          },
          {
            "name": "runtime-tmp",
            "emptyDir": {
              "sizeLimit": "64Mi"
            }
          }
        ]
      }
    }
  }
}
